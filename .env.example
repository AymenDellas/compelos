DATABASE_URL=postgresql://user:password@host:5432/database
DASHBOARD_PASSWORD_HASH=scrypt:salt:hash
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://compelos-three.vercel.app
QUICKEMAILVERIFICATION_API_KEY=replace-with-your-server-side-api-key
# Optional integrations: AGENTROUTER_API_KEY, COPY_STUDIO_API_KEY,
# GROQ_API_KEY, SERPER_API_KEY_1, GMAIL_ACCOUNTS. Keep credentials in server secrets.
# OpenAI-compatible providers also use AGENTROUTER_BASE_URL / AGENTROUTER_MODEL
# and COPY_STUDIO_BASE_URL / COPY_STUDIO_MODEL. CONTENT_AI_VISION_MODEL is optional.
