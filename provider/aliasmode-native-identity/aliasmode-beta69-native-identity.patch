--- /dev/null
+++ b/native-clock.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test";
+import { watchNativeClock } from "./native-clock.ts";
+
+class Socket {
+  static current: Socket;
+  readyState = 0;
+  onopen?: () => void;
+  onmessage?: (event: { data: string }) => void;
+  onerror?: () => void;
+  onclose?: () => void;
+  calls: any[] = [];
+  constructor(_endpoint: string) { Socket.current = this; queueMicrotask(() => { this.readyState = 1; this.onopen?.(); }); }
+  send(wire: string) {
+    const m = JSON.parse(wire); this.calls.push(m);
+    if (m.method === "Emulation.setTimezoneOverride") return;
+    queueMicrotask(() => this.emit({ id: m.id, result: m.method === "Target.getTargets" ? { targetInfos: [] } : {} }));
+  }
+  emit(message: object) { this.onmessage?.({ data: JSON.stringify(message) }); }
+  close() { this.readyState = 3; this.onclose?.(); }
+}
+const pause = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+test("a terminated worker retires its unanswered command without marking the live clock failed", async () => {
+  let faults = 0;
+  const clock = await watchNativeClock("ws://fixture", "America/New_York", { WebSocket: Socket as unknown as typeof WebSocket, timeoutMs: 30, onFault: () => { faults++; } });
+  try {
+    Socket.current.emit({ method: "Target.attachedToTarget", params: { sessionId: "worker-session", targetInfo: { type: "worker", targetId: "worker-target" } } });
+    Socket.current.emit({ method: "Target.detachedFromTarget", params: { sessionId: "worker-session" } });
+    await pause(60); expect(clock.healthy()).toBe(true); expect(faults).toBe(0);
+    expect(Socket.current.calls.some(c => c.method === "Runtime.enable")).toBe(false);
+  } finally { clock.stop(); }
+});
+test("an unanswered clock command on a live worker remains a blocking failure after ordered startup resume", async () => {
+  let faults = 0;
+  const clock = await watchNativeClock("ws://fixture", "America/New_York", { WebSocket: Socket as unknown as typeof WebSocket, timeoutMs: 30, onFault: () => { faults++; } });
+  try {
+    Socket.current.emit({ method: "Target.attachedToTarget", params: { sessionId: "worker-session", targetInfo: { type: "worker", targetId: "worker-target" } } });
+    await pause(60); expect(clock.healthy()).toBe(false); expect(faults).toBe(1); expect(clock.failure()).toContain("worker timed out");
+    expect(Socket.current.calls.findIndex(c => c.method === "Emulation.setTimezoneOverride")).toBeLessThan(Socket.current.calls.findIndex(c => c.method === "Runtime.runIfWaitingForDebugger"));
+    expect(Socket.current.calls.some(c => c.method === "Runtime.enable")).toBe(false);
+  } finally { clock.stop(); }
+});
