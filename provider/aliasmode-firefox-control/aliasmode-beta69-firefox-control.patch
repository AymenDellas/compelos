diff --git a/firefox-control.ts b/firefox-control.ts
new file mode 100644
index 0000000..354c5e5
--- /dev/null
+++ b/firefox-control.ts
@@ -0,0 +1,13 @@
+// Operational startup policy only. Never changes a stored device identity.
+export const NATIVE_FIREFOX_TAG = "compelos-firefox-native-v1";
+export function controlledFirefox(profile: { engine?: string; tags?: string[] } | null | undefined): boolean {
+  return profile?.engine === "firefox" && profile.tags?.includes(NATIVE_FIREFOX_TAG) === true;
+}
+export function withoutStartupTabs(bundle: string): string {
+  if (!bundle) return bundle;
+  const data = JSON.parse(bundle);
+  if (!data || typeof data !== "object" || Array.isArray(data)) throw new Error("invalid saved session");
+  // Filter a launch-local copy. Cookie/origin restoration still uses the
+  // existing validator; the saved bundle and browser history stay intact.
+  return JSON.stringify({ ...data, tabs: [] });
+}
