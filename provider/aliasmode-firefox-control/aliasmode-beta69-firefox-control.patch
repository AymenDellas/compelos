+import { test, expect } from "bun:test";
+import { NATIVE_FIREFOX_TAG, controlledFirefox, withoutStartupTabs } from "./firefox-control.ts";
+test("blank startup is explicit and does not select legacy Firefox or any Chromium identity", () => {
+  expect(controlledFirefox({ engine: "firefox", tags: [NATIVE_FIREFOX_TAG] })).toBe(true);
+  expect(controlledFirefox({ engine: "firefox" })).toBe(false);
+  expect(controlledFirefox({ engine: "chromium", tags: [NATIVE_FIREFOX_TAG] })).toBe(false);
+});
+test("launch-local tab filtering preserves every cookie/storage value and the original bundle", () => {
+  const data = { version: 3, cookies: [{ name: "fixture-session", value: "fixture-only" }], origins: [{ origin: "https://fixture.test", localStorage: [{ name: "state", value: "kept" }] }], tabs: ["https://fixture.test/in/old"] };
+  const original = JSON.stringify(data), filtered = JSON.parse(withoutStartupTabs(original));
+  expect(filtered).toEqual({ ...data, tabs: [] });
+  expect(JSON.parse(original)).toEqual(data);
+  expect(withoutStartupTabs("")).toBe("");
+});
