@@ -11,0 +12 @@ import {
+  COMPELOS_NATIVE_READBACK_TAG,
@@ -38,0 +40,11 @@ function profile(overrides: Partial<Profile> = {}): Profile {
+test("explicit native readback removes only the noise switch; existing profile flags remain unchanged", () => {
+  const original = profile({ chromiumRuntime: "aliasmode", tags: ["keep-this-tag"] });
+  const before = structuredClone(original);
+  const seeded = deriveFingerprintFlags(original, 4);
+  const native = deriveFingerprintFlags({ ...original, tags: [...original.tags!, COMPELOS_NATIVE_READBACK_TAG] }, 4);
+  expect(seeded).toContain("--fingerprint-noise");
+  expect(native).toEqual(seeded.filter(flag => flag !== "--fingerprint-noise"));
+  expect(original).toEqual(before);
+  expect(deriveFingerprintFlags({ ...original, tags: ["compelos-native-readback-v0"] }, 4)).toEqual(seeded);
+});
+
