+export const COMPELOS_NATIVE_READBACK_TAG = "compelos-native-readback-v1";
+export const COMPELOS_READBACK_PATCH = "COMPELOS_ALIASMODE_READBACK_V1";
+export function nativeReadback(profile: Pick<Profile, "tags">): boolean {
+  return profile.tags?.includes(COMPELOS_NATIVE_READBACK_TAG) === true;
+}
