@@ -301,0 +307,15 @@ export class AgentControlSession {
+  private async readbackStatus(params: Record<string, unknown>) {
+    if (params.profileId === undefined) return { patchVersion: COMPELOS_READBACK_PATCH, capability: "native-readback-opt-in-v1" };
+    const profileId = stringParam(params, "profileId");
+    assertSafeProfileId(profileId);
+    let profile;
+    if (this.deps.cloudBrowser) {
+      const { connection } = this.cloudMcpConnection();
+      const authoritative = await connection.client.getProfile(profileId);
+      profile = decodePortableProfile(authoritative.payload).profile;
+    } else profile = this.deps.store.getProfile(profileId);
+    if (!profile || profile.id !== profileId) throw agentError("profile_not_found", "profile not found");
+    const supported = (profile.engine ?? "chromium") === "chromium" && profile.chromiumRuntime === "aliasmode";
+    return { profileId, supported, mode: supported ? nativeReadback(profile) ? "native" : "seeded" : "engine-default", patchVersion: COMPELOS_READBACK_PATCH };
+  }
+
diff --git a/agent/aliasmode-mcp.ts b/agent/aliasmode-mcp.ts
index db2bfa8..75716e0 100644
--- a/agent/aliasmode-mcp.ts
+++ b/agent/aliasmode-mcp.ts
@@ -7,0 +8 @@ import { ALIASMODE_VERSION } from "../version.ts";
+import { COMPELOS_NATIVE_READBACK_TAG, COMPELOS_READBACK_PATCH } from "../fingerprint.ts";
@@ -173 +174,32 @@ async function profiles(args: string[]): Promise<unknown> {
-  throw new Error("profiles requires list, create, or delete");
+  if (action === "readback") {
+    const mode = value(rest, "mode") ?? "status";
+    if (mode === "capability") return await withRuntime((client) => client.call("profiles.readbackStatus"));
+    const profileId = requireProfile(rest);
+    if (!["status", "native", "seeded"].includes(mode)) throw new Error("readback mode requires status, native or seeded");
+    return await withRuntime(async (client) => {
+      // Ask the running manager, so a patched helper cannot certify an old
+      // unpatched launcher that would silently keep altering the readback.
+      const capability = await client.call("profiles.readbackStatus", { profileId });
+      if (capability.patchVersion !== COMPELOS_READBACK_PATCH) throw new Error("the running manager lacks the native readback patch");
+      if (mode !== "status" && capability.supported !== true) throw new Error("native readback requires AliasMode Chromium");
+      const roster = await client.call("profiles.list");
+      const profile = roster.profiles.find((p: { id: string }) => p.id === profileId);
+      if (!profile) throw new Error("profile not found");
+      const tags: string[] = Array.isArray(profile.tags) ? profile.tags : [];
+      const current = capability.mode;
+      if (mode !== "status" && mode !== current) {
+        if (profile.running) throw new Error("close the profile before changing readback mode");
+        if (!Number.isSafeInteger(profile.expectedVersion) || profile.permission !== "edit") throw new Error("readback changes require an editable Cloud profile and its current version");
+        const nextTags = tags.filter(t => t !== COMPELOS_NATIVE_READBACK_TAG);
+        if (mode === "native") nextTags.push(COMPELOS_NATIVE_READBACK_TAG);
+        await client.call("profiles.update", { profileId, expectedVersion: profile.expectedVersion, set: { tags: nextTags } });
+        const updated = await client.call("profiles.list");
+        const saved = updated.profiles.find((p: { id: string }) => p.id === profileId);
+        if (!saved || (saved.tags?.includes(COMPELOS_NATIVE_READBACK_TAG) ? "native" : "seeded") !== mode) throw new Error("readback configuration was not confirmed");
+      }
+      const observed = await client.call("profiles.readbackStatus", { profileId });
+      if (observed.mode !== (mode === "status" ? current : mode) || observed.patchVersion !== COMPELOS_READBACK_PATCH) throw new Error("manager readback configuration was not confirmed");
+      return observed;
+    });
+  }
+  throw new Error("profiles requires list, create, readback or delete");
diff --git a/fingerprint.test.ts b/fingerprint.test.ts
index 18f5ce7..0799708 100644
--- a/fingerprint.test.ts
